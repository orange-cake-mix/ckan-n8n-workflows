        "jsCode": "/*\n * Baut getrennte CKAN-Payloads für Insert und Update.\n * Unveränderte Messwerte werden gezählt, aber nicht erneut geschrieben.\n */\n\nfunction parseMaybeJson(value) {\n  if (typeof value !== 'string') return value;\n  const trimmed = value.trim();\n  if (!trimmed) return value;\n  try {\n    return JSON.parse(trimmed);\n  } catch (error) {\n    return value;\n  }\n}\n\n// Holt den bereits existierenden CKAN-Datensatz aus unterschiedlichen möglichen Antwortstrukturen.\nfunction getExistingRecord(check) {\n  const body = parseMaybeJson(check?.body);\n  const data = parseMaybeJson(check?.data);\n\n  return (\n    body?.result?.records?.[0] ??\n    data?.result?.records?.[0] ??\n    check?.result?.records?.[0] ??\n    body?.records?.[0] ??\n    data?.records?.[0] ??\n    check?.records?.[0] ??\n    null\n  );\n}\n\n// Prüft, ob die CKAN-Antwort einen Fehler enthält.\nfunction responseHasError(check) {\n  const body = parseMaybeJson(check?.body);\n  const data = parseMaybeJson(check?.data);\n  const response = body ?? data ?? check;\n  return check?.statusCode >= 400 || response?.success === false || response?.error;\n}\n\n// Vergleicht zwei Zahlen mit kleiner Toleranz, damit Rundungsunterschiede keine Updates auslösen.\nfunction numbersAlmostEqual(a, b, tolerance = 0.0005) {\n  const numA = Number(a);\n  const numB = Number(b);\n  if (!Number.isFinite(numA) || !Number.isFinite(numB)) return false;\n  return Math.abs(numA - numB) <= tolerance;\n}\n\nconst checkItems = $input.all();\nconst validRecords = $items('08 Nur gültige Messwerte', 0).map(i => i.json);\n\nconst insertRecords = [];\nconst updateRecords = [];\nconst errors = [];\nlet unchanged = 0;\n\nfor (let i = 0; i < validRecords.length; i++) {\n  const rec = validRecords[i];\n  const check = checkItems[i]?.json ?? {};\n\n  const ckanRecord = {\n    zeitstempel: rec.zeitstempel,\n    messstelle_id: Number(rec.messstelle_id),\n    pegelstand_in_m: Number(rec.pegelstand_in_m)\n  };\n\n  if