    {
      "parameters": {
        "jsCode": "/*\n * Wandelt PEGELONLINE-Antworten in CKAN-kompatible Messwert-Items um.\n * Nicht benötigte Zusatzdaten werden bewusst nicht gespeichert.\n */\n\n// Rechnet PEGELONLINE-Werte in Meter um. Standardfall: PEGELONLINE liefert Wasserstände in cm.\nfunction toMeters(value, unit) {\n  const number = Number(value);\n  if (!Number.isFinite(number)) return null;\n\n  const normalizedUnit = String(unit || '').trim().toLowerCase();\n  if (normalizedUnit === 'm' || normalizedUnit === 'meter') return number;\n\n  return number / 100;\n}\n\n// Parst JSON-Strings, falls ein HTTP-Node body/data als Text statt als Objekt liefert.\nfunction parseMaybeJson(value) {\n  if (typeof value !== 'string') return value;\n  const trimmed = value.trim();\n  if (!trimmed) return value;\n  try {\n    return JSON.parse(trimmed);\n  } catch (error) {\n    return value;\n  }\n}\n\nconst responseItems = $input.all();\nconst stationItems = $items('05 Nur Stationen mit gültigem Zeitraum', 0);\nconst out = [];\n\n// Verarbeitet jede PEGELONLINE-Antwort passend zur jeweiligen Messstelle.\nfor (let i = 0; i < responseItems.length; i++) {\n  const responseRaw = responseItems[i]?.json ?? {};\n  const station = stationItems[i]?.json;\n\n  if (!station) continue;\n\n  let response = responseRaw.body ?? responseRaw.data ?? responseRaw;\n  response = parseMaybeJson(response);\n\n  if (responseRaw?.statusCode >= 400 || response?.error) {\n    out.push({\n      json: {\n        __skip: true,\n        status: 'api_error',\n        fehler: `PEGELONLINE-Fehler bei ${station.name}.`,\n        messstelle_id: Number(station.pegel_id),\n        messstelle_name: station.name,\n        pegelonline_uuid: station.pegelonline_uuid\n      }\n    });\n    continue;\n  }\n\n  const measurements = Array.isArray(response)\n    ? response\n    : Array.isArray(response?.measurements)\n      ? response.measurements\n      : response?.timestamp && response?.value !== undefined\n        ? [response]\n        : [];\n\n  if (measurements.length === 0) {\n    out.push({\n      json: {\n        __skip: true,\n        status: 'no_new_values',\n        fehler: `Keine neuen Messwerte bei ${station.name}.`,\n        messstelle_id: Number(station.pegel_id),\n        messstelle_name: station.name,\n        pegelonline_uuid: station.pegelonline_uuid\n      }\n    });\n    continue;\n  }\n\n  for (const measurement of measurements) {\n    const timestamp = measurement.timestamp;\n    const value = measurement.value;\n    const pegelstandInM = toMeters(value, station.pegelonline_unit);\n\n    if (!timestamp || pegelstandInM === null) {\n      out.push({\n        json: {\n          __skip: true,\n          status: 'invalid_measurement',\n          fehler: `Ungültiger Messwert bei ${station.name}.`,\n          messstelle_id: Number(station.pegel_id),\n          messstelle_name: station.name,\n          pegelonline_uuid: station.pegelonline_uuid\n        }\n      });\n      continue;\n    }\n\n    out.push({\n      json: {\n        __skip: false,\n        status: 'valid',\n        ckanBaseUrl: station.ckanBaseUrl,\n        pegelwerteResourceId: station.pegelwerteResourceId,\n        zeitstempel: timestamp,\n        messstelle_id: Number(station.pegel_id),\n        pegelstand_in_m: Number(pegelstandInM.toFixed(3)),\n        messstelle_name: station.name,\n        pegelonline_uuid: station.pegelonline_uuid\n      }\n    });\n  }\n}\n\nreturn out;"
